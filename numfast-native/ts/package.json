{
  "name": "@numfast/kernels",
  "version": "0.2.1",
  "description": "NumFast compute kernels compiled to WebAssembly: 86 functions, one memory, no imports. Portable kernel library, not a compute core.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/numfast/numfast.git",
    "directory": "numfast-native/ts"
  },
  "homepage": "https://github.com/numfast/numfast",
  "bugs": {
    "url": "https://github.com/numfast/numfast/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js",
      "default": "./dist/bridge.js"
    },
    "./kernels": {
      "types": "./dist/kernels.d.ts",
      "import": "./dist/kernels.js",
      "default": "./dist/kernels.js"
    },
    "./wasm": "./dist/numfast_native.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "corresp_src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "abi": "node build.mjs --check-only",
    "prepack": "node corresp-src.mjs",
    "corresp": "node corresp-src.mjs --check"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "webassembly",
    "wasm",
    "kernels",
    "numfast",
    "agpl"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
